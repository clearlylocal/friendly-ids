{
	"lock": false,
	"tasks": {
		"test": "deno test -A --watch tests"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1.0.6",
		"@std/csv": "jsr:@std/csv@^1.0.3"
	},
	"fmt": {
		"semiColons": false,
		"useTabs": true,
		"lineWidth": 120,
		"indentWidth": 4,
		"singleQuote": true,
		"proseWrap": "preserve",
		"exclude": []
	},
	"compilerOptions": { "strict": true },
	"lint": { "rules": { "tags": ["recommended"] } },
	"exclude": []
}
